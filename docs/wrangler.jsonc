/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "svelte-page-jsonview",
    "compatibility_date": "2026-04-21",
    "compatibility_flags": ["nodejs_als", "nodejs_compat"],
    "main": ".svelte-kit/cloudflare/_worker.js",
    "assets": {
        "directory": ".svelte-kit/cloudflare",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    },
    "upload_source_maps": true,
    /**
     * Route binding intentionally omitted — the `jsonview.svelte.page`
     * custom domain is provisioned via terraform (same pattern as the
     * sibling svelte-page-markdown worker). Declaring it here would
     * make wrangler call the zone-scoped Workers Routes API on every
     * deploy, which requires permissions the CI token does not carry.
     */
    "vars": {
        "PUBLIC_ENVIRONMENT": "production",
        "ENVIRONMENT": "production",
        "NODE_ENV": "production",
        // checkov:skip=CKV_SECRET_6: PostHog project tokens are public client-side SDK identifiers.
        "PUBLIC_POSTHOG_PROJECT_TOKEN": "phc_ucGDJdYW5q2aXEfnzTuSCX4BnHkgwtqUV8RgEt4nb5Qq",
        "PUBLIC_POSTHOG_HOST": "https://t.svelte.page"
    }
}
