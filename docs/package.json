{
    "name": "docs",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsx ./scripts/fetch-github-stats.ts && vite build",
        "cf-typegen": "wrangler types src/worker-configuration.d.ts",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "deploy": "npm run build && wrangler deploy",
        "dev": "vite dev",
        "format": "prettier --write .",
        "preview": "vite preview"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.2.8",
        "@fontsource-variable/jetbrains-mono": "^5.2.8",
        "@humanspeak/docs-kit": "github:humanspeak/docs-kit#8d0a50f",
        "@humanspeak/svelte-json-view-lite": "workspace:*",
        "@humanspeak/svelte-markdown": "^1.5.2",
        "runed": "^0.37.1"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20260527.1",
        "@humanspeak/svelte-motion": "^0.4.9",
        "@icons-pack/svelte-simple-icons": "^7.2.0",
        "@lucide/svelte": "^1.16.0",
        "@sveltejs/adapter-cloudflare": "^7.2.8",
        "@sveltejs/kit": "^2.61.1",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.3.0",
        "chokidar-cli": "^3.0.0",
        "mdsvex": "^0.12.7",
        "mode-watcher": "^1.1.0",
        "shiki": "^4.1.0",
        "svelte": "^5.55.9",
        "svelte-check": "^4.4.8",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.0",
        "tsx": "^4.22.3",
        "typescript": "^6.0.3",
        "vite": "^8.0.14",
        "wrangler": "^4.95.0"
    },
    "volta": {
        "node": "24.15.0"
    }
}
