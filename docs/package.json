{
    "name": "docs",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsx ./scripts/fetch-github-stats.ts && vite build",
        "build:indexnow": "tsx ./scripts/fetch-github-stats.ts && vite build --mode indexnow",
        "cf-typegen": "wrangler types src/worker-configuration.d.ts",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "deploy": "npm run build:indexnow && wrangler deploy",
        "dev": "vite dev",
        "format": "prettier --write .",
        "preview": "vite preview"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@humanspeak/docs-kit": "github:humanspeak/docs-kit#2026.8.4",
        "@humanspeak/svelte-json-view-lite": "workspace:*",
        "@humanspeak/svelte-markdown": "^1.8.7",
        "runed": "^0.37.1"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20260821.1",
        "@humanspeak/svelte-motion": "^0.9.3",
        "@icons-pack/svelte-simple-icons": "^7.2.0",
        "@lucide/svelte": "^1.33.0",
        "@sveltejs/adapter-cloudflare": "^7.2.9",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "chokidar-cli": "^3.0.0",
        "mdsvex": "^0.12.8",
        "mode-watcher": "^1.1.0",
        "shiki": "^4.4.3",
        "svelte": "^5.56.10",
        "svelte-check": "^4.7.6",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.12",
        "typescript": "^6.0.3",
        "vite": "^8.2.2",
        "wrangler": "^4.125.0"
    },
    "volta": {
        "node": "24.15.0"
    }
}
